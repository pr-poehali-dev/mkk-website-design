{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Start new chat session",
      "method": "POST",
      "path": "/",
      "body": {"action": "start", "name": "Тест", "phone": "+79001234567"},
      "expectedStatus": 201
    },
    {
      "name": "GET without session_key",
      "method": "GET",
      "path": "/",
      "expectedStatus": 400
    },
    {
      "name": "Admin list without token",
      "method": "GET",
      "path": "/?admin=1",
      "expectedStatus": 403
    },
    {
      "name": "Send without session_key",
      "method": "POST",
      "path": "/",
      "body": {"action": "send", "text": "hello"},
      "expectedStatus": 400
    }
  ]
}
