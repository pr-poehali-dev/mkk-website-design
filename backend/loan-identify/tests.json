{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET without token",
      "method": "GET",
      "path": "/",
      "expectedStatus": 400
    },
    {
      "name": "GET unknown token",
      "method": "GET",
      "path": "/?token=nonexistent123",
      "expectedStatus": 404
    },
    {
      "name": "Generate without ref_number",
      "method": "POST",
      "path": "/",
      "body": {"action": "generate"},
      "expectedStatus": 400
    },
    {
      "name": "Generate unknown ref_number",
      "method": "POST",
      "path": "/",
      "body": {"action": "generate", "ref_number": "ZP-NONEXISTENT-XYZ"},
      "expectedStatus": 404
    },
    {
      "name": "Submit without token",
      "method": "POST",
      "path": "/",
      "body": {"action": "submit"},
      "expectedStatus": 400
    }
  ]
}